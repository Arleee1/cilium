# acn-specific Makefile extension for the images directory.
#
# Usage:
#   make -f Makefile.acn <target>
#
# This Makefile includes the upstream Makefile (all existing targets remain
# available) and adds:
#   - DOCKER_BUILD_ARGS: pass arbitrary --build-arg flags to docker buildx.
#   - ACN_REGISTRIES: override the target registries for acn builds.
#   - acn-* targets that mirror the upstream image targets but route through
#     scripts/acn-build-image.sh so DOCKER_BUILD_ARGS are forwarded.
#
# Example — build cilium with a custom build arg:
#   make -f Makefile.acn acn-cilium-image DOCKER_BUILD_ARGS="MY_FLAG=1"
#
# Example — override registries and push:
#   make -f Makefile.acn acn-cilium-image \
#     ACN_REGISTRIES="acnpublic.azurecr.io/cilium" PUSH=true

# Pull in all upstream variables and targets.
include Makefile

# ---- acn-specific variables ------------------------------------------------

# ACN Golang image (MCR-hosted Microsoft Go fork).
GOLANG_IMAGE ?= mcr.microsoft.com/oss/go/microsoft/golang:1.26.7-1@sha256:be14ce4ce048adf5584ce3a0919d21987284e2235b6e7e9bb0e6a01133870be9
export GOLANG_IMAGE

# ACN base/runtime image.
BASE_IMAGE ?= mcr.microsoft.com/azurelinux/distroless/base:3.0
export BASE_IMAGE


# Space-separated KEY=VALUE pairs forwarded as --build-arg to docker buildx.
# Example: DOCKER_BUILD_ARGS=HTTP_PROXY=http://proxy:8080 CUSTOM_FLAG=1
DOCKER_BUILD_ARGS ?= GOEXPERIMENT=ms_nocgo_opensslcrypto GOLANG_IMAGE=$(GOLANG_IMAGE) BASE_IMAGE=$(BASE_IMAGE)
export DOCKER_BUILD_ARGS

# Registries used by acn-* targets.  Defaults to the upstream REGISTRIES.
ACN_REGISTRIES ?= $(REGISTRIES)

# Include the complete ACN recipe so any change to this file invalidates the
# base images that the recipe builds and downstream jobs consume.
ACN_MAKEFILE_INPUT_HASH := $(shell sha256sum Makefile.acn | cut -c1-12)

# Compute the runtime image tag (git tree hash of images/runtime) combined with
# a fingerprint of the ACN recipe and build-arg inputs.
ACN_RUNTIME_IMAGE_INPUT_HASH := $(shell printf '%s\n%s\n' "$(ACN_MAKEFILE_INPUT_HASH)" "$(DOCKER_BUILD_ARGS)" | sha256sum | cut -c1-12)
ACN_RUNTIME_IMAGE_TAG := $(shell scripts/make-image-tag.sh images/runtime)-$(ACN_RUNTIME_IMAGE_INPUT_HASH)
ACN_RUNTIME_IMAGE_NAME := cilium-runtime
# First word of ACN_REGISTRIES is used as the base for image references.
ACN_RUNTIME_IMAGE := $(firstword $(ACN_REGISTRIES))/$(ACN_RUNTIME_IMAGE_NAME):$(ACN_RUNTIME_IMAGE_TAG)

# Compute the builder image tag.  The builder depends on the runtime image, so
# include that in the hash to ensure tag changes cascade correctly.
ACN_BUILDER_IMAGE_INPUT_HASH := $(shell printf '%s\n%s\n' "$(DOCKER_BUILD_ARGS)" "$(ACN_RUNTIME_IMAGE)" | sha256sum | cut -c1-12)
ACN_BUILDER_IMAGE_TAG := $(shell scripts/make-image-tag.sh images/builder)-$(ACN_BUILDER_IMAGE_INPUT_HASH)
ACN_BUILDER_IMAGE_NAME := cilium-builder
ACN_BUILDER_IMAGE := $(firstword $(ACN_REGISTRIES))/$(ACN_BUILDER_IMAGE_NAME):$(ACN_BUILDER_IMAGE_TAG)

# Distroless image directories.
DISTROLESS_RUNTIME_DIRECTORY ?= images/distroless/runtime

# Keep the distroless agent aligned with upstream while excluding binaries
# that belong only in the split init image.
CILIUM_DISTROLESS_INIT_ONLY_SUBDIRS := tools/mount tools/sysctlfix plugins/cilium-cni
CILIUM_CONTAINER_SUBDIRS = $(shell sed -n 's/^SUBDIRS_CILIUM_CONTAINER := //p' ../Makefile | head -1)
CILIUM_DISTROLESS_AGENT_SUBDIRS = $(filter-out $(CILIUM_DISTROLESS_INIT_ONLY_SUBDIRS),$(CILIUM_CONTAINER_SUBDIRS))
CILIUM_DISTROLESS_INIT_SUBDIRS := cilium-dbg $(CILIUM_DISTROLESS_INIT_ONLY_SUBDIRS)

# Compute the distroless runtime image tag and reference.
ACN_DISTROLESS_RUNTIME_IMAGE_INPUT_HASH := $(shell printf '%s\n%s\n' "$(ACN_MAKEFILE_INPUT_HASH)" "$(DOCKER_BUILD_ARGS)" | sha256sum | cut -c1-12)
ACN_DISTROLESS_RUNTIME_IMAGE_TAG := $(shell scripts/make-image-tag.sh images/distroless/runtime)-$(ACN_DISTROLESS_RUNTIME_IMAGE_INPUT_HASH)
ACN_DISTROLESS_RUNTIME_IMAGE_NAME := cilium-runtime-distroless
ACN_DISTROLESS_RUNTIME_IMAGE := $(firstword $(ACN_REGISTRIES))/$(ACN_DISTROLESS_RUNTIME_IMAGE_NAME):$(ACN_DISTROLESS_RUNTIME_IMAGE_TAG)

# Compute the distroless builder image tag and reference.
# The builder depends on the distroless runtime image, so include that in the hash.
ACN_DISTROLESS_BUILDER_IMAGE_INPUT_HASH := $(shell printf '%s\n%s\n' "$(DOCKER_BUILD_ARGS)" "$(ACN_DISTROLESS_RUNTIME_IMAGE)" | sha256sum | cut -c1-12)
ACN_DISTROLESS_BUILDER_IMAGE_TAG := $(shell scripts/make-image-tag.sh images/distroless/builder)-$(ACN_DISTROLESS_BUILDER_IMAGE_INPUT_HASH)
ACN_DISTROLESS_BUILDER_IMAGE_NAME := cilium-builder-distroless
ACN_DISTROLESS_BUILDER_IMAGE := $(firstword $(ACN_REGISTRIES))/$(ACN_DISTROLESS_BUILDER_IMAGE_NAME):$(ACN_DISTROLESS_BUILDER_IMAGE_TAG)

# ---- acn image targets -----------------------------------------------------
#
# These targets use scripts/acn-build-image.sh, which follows the same
# interface as scripts/build-image.sh but additionally forwards
# DOCKER_BUILD_ARGS as --build-arg flags.
#
# To add a new acn-specific image, follow the pattern:
#
#   my-acn-image: .buildx_builder
#   	ROOT_CONTEXT=true scripts/acn-build-image.sh my-image-dev images/my-image \
#   		$(PLATFORMS) $(OUTPUT) "$$(cat .buildx_builder)" $(ACN_REGISTRIES)
#

acn-all-images: acn-runtime-image acn-builder-image acn-distroless-runtime-image acn-distroless-builder-image acn-cilium-image acn-operator-image acn-hubble-relay-image

acn-runtime-image: .buildx_builder
	IMAGE_TAG=$(ACN_RUNTIME_IMAGE_TAG) DOCKER_BUILD_TARGET="" scripts/acn-build-image.sh cilium-runtime images/runtime $(PLATFORMS) $(OUTPUT) "$$(cat .buildx_builder)" $(ACN_REGISTRIES)

acn-builder-image: .buildx_builder
	IMAGE_TAG=$(ACN_BUILDER_IMAGE_TAG) DOCKER_BUILD_ARGS="$(DOCKER_BUILD_ARGS) CILIUM_RUNTIME_IMAGE=$(ACN_RUNTIME_IMAGE)" scripts/acn-build-image.sh cilium-builder images/builder $(PLATFORMS) $(OUTPUT) "$$(cat .buildx_builder)" $(ACN_REGISTRIES)

acn-distroless-runtime-image: .buildx_builder
	IMAGE_TAG=$(ACN_DISTROLESS_RUNTIME_IMAGE_TAG) ROOT_CONTEXT=true scripts/acn-build-image.sh cilium-runtime-distroless images/distroless/runtime $(PLATFORMS) $(OUTPUT) "$$(cat .buildx_builder)" $(ACN_REGISTRIES)

acn-distroless-builder-image: .buildx_builder
	IMAGE_TAG=$(ACN_DISTROLESS_BUILDER_IMAGE_TAG) DOCKER_BUILD_ARGS="$(DOCKER_BUILD_ARGS) CILIUM_RUNTIME_IMAGE=$(ACN_DISTROLESS_RUNTIME_IMAGE)" ROOT_CONTEXT=true scripts/acn-build-image.sh cilium-builder-distroless images/distroless/builder $(PLATFORMS) $(OUTPUT) "$$(cat .buildx_builder)" $(ACN_REGISTRIES)

acn-update-distroless-runtime-image:
	distroless/scripts/update-cilium-runtime-image.sh $(ACN_DISTROLESS_RUNTIME_IMAGE) $(DISTROLESS_RUNTIME_DIRECTORY)

acn-update-distroless-builder-image:
	distroless/scripts/update-cilium-builder-image.sh

acn-build-distroless-agent:
	$(MAKE) -C .. SUBDIRS_CILIUM_CONTAINER="$(CILIUM_DISTROLESS_AGENT_SUBDIRS)" build-container install-container-binary

acn-build-distroless-init:
	$(MAKE) -C .. SUBDIRS_CILIUM_CONTAINER="$(CILIUM_DISTROLESS_INIT_SUBDIRS)" build-container install-container-binary

acn-cilium-image: .buildx_builder
	DOCKER_BUILD_ARGS="$(DOCKER_BUILD_ARGS) CILIUM_BUILDER_IMAGE=$(ACN_BUILDER_IMAGE) CILIUM_RUNTIME_IMAGE=$(ACN_RUNTIME_IMAGE)" ROOT_CONTEXT=true scripts/acn-build-image.sh cilium-dev images/cilium $(PLATFORMS) $(OUTPUT) "$$(cat .buildx_builder)" $(ACN_REGISTRIES)

acn-operator-image: .buildx_builder
	DOCKER_BUILD_ARGS="$(DOCKER_BUILD_ARGS) CILIUM_BUILDER_IMAGE=$(ACN_BUILDER_IMAGE)" ROOT_CONTEXT=true scripts/acn-build-image.sh operator-dev images/operator $(PLATFORMS) $(OUTPUT) "$$(cat .buildx_builder)" $(ACN_REGISTRIES)

acn-hubble-relay-image: .buildx_builder
	DOCKER_BUILD_ARGS="$(DOCKER_BUILD_ARGS) CILIUM_BUILDER_IMAGE=$(ACN_BUILDER_IMAGE)" ROOT_CONTEXT=true scripts/acn-build-image.sh hubble-relay-dev images/hubble-relay $(PLATFORMS) $(OUTPUT) "$$(cat .buildx_builder)" $(ACN_REGISTRIES)

# ---- print helpers ----------------------------------------------------------
# Use these targets to query computed ACN image tags/references from scripts or
# CI pipelines:
#   make -C images -f Makefile.acn --no-print-directory print-acn-runtime-tag

print-acn-runtime-tag:
	@echo $(ACN_RUNTIME_IMAGE_TAG)

print-acn-builder-tag:
	@echo $(ACN_BUILDER_IMAGE_TAG)

print-acn-runtime-image:
	@echo $(ACN_RUNTIME_IMAGE)

print-acn-builder-image:
	@echo $(ACN_BUILDER_IMAGE)

print-acn-distroless-runtime-tag:
	@echo $(ACN_DISTROLESS_RUNTIME_IMAGE_TAG)

print-acn-distroless-builder-tag:
	@echo $(ACN_DISTROLESS_BUILDER_IMAGE_TAG)

print-acn-distroless-runtime-image:
	@echo $(ACN_DISTROLESS_RUNTIME_IMAGE)

print-acn-distroless-builder-image:
	@echo $(ACN_DISTROLESS_BUILDER_IMAGE)

print-acn-distroless-agent-subdirs:
	@echo $(CILIUM_DISTROLESS_AGENT_SUBDIRS)

print-acn-distroless-init-subdirs:
	@echo $(CILIUM_DISTROLESS_INIT_SUBDIRS)
